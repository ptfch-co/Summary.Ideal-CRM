@model Summary.IdealCrm.Workflows.Task.Quote.Create.CreateQuoteInIdealCrmTaskViewModel
@inject Microsoft.Extensions.Options.IOptions<Summary.IdealCrm.Settings.IdealCrmSettings> _options;

<div class="row">
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="UserName">
            <label asp-for="UserName">کلید کاربری</label>
            <input type="text" asp-for="UserName" class="form-control" placeholder="@_options.Value.UserName" />
            <span class="hint">برای دریافت کلید کاربری با پشتیبانی CRM ایده آل تماس بگیرید.</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Password">
            <label asp-for="Password">توکن</label>
            <input type="text" asp-for="Password" class="form-control" placeholder="@_options.Value.Password" />
            <span class="hint">برای دریافت توکن با پشتیبانی CRM ایده آل تماس بگیرید.</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Company">
            <label asp-for="Company">
                مخاطب مرتبط (CompanyId)
                <span class="text-danger">*</span>
            </label>
            <input type="text" asp-for="Company" class="form-control" />
            <span class="hint">با مقداردهی این فیلد تعیین میکنید فرم به کدام یک از مخاطبین متصل شود.</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Personnel">
            <label asp-for="Personnel">
                پرسنل مرتبط(PersonnelId)
                <span class="text-danger">*</span>
            </label>
            <input type="text" asp-for="Personnel" class="form-control" />
            <span class="hint">با مقداردهی این فیلد تعیین میکنید فرم به کدام یک از پرسنل متصل شود.</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Project">
            <label asp-for="Project">
                پروژه مرتبط (ProjectId)
                <span class="text-danger">*</span>
            </label>
            <input type="text" asp-for="Project" class="form-control" />
            <span class="hint">
                با مقداردهی این فیلد تعیین میکنید فرم به کدام یک از پروژه‌ها متصل شود.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Title">
            <label asp-for="Title">
                عنوان
                <span class="text-danger">*</span>
            </label>
            <input type="text" asp-for="Title" class="form-control" />
            <span class="hint">
                برای درج عنوان پیش فاکتور از طریق این فیلد اقدام کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Number">
            <label asp-for="Number">شماره</label>
            <input type="text" asp-for="Number" class="form-control" />
            <span class="hint">
                شماره پیش فاکتور را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Date">
            <label asp-for="Date">تاریخ</label>
            <input type="text" asp-for="Date" class="form-control" />
            <span class="hint">
                تاریخ پیش فاکتور را از طریق این فیلد مقداردهی کنید.</br>
                نمونه قالب: "yyyy/MM/dd HH:mm:ss"
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Subject">
            <label asp-for="Subject">
                موضوع
            </label>
            <input type="text" asp-for="Subject" class="form-control" />
            <span class="hint">موضوع پیش فاکتور را از طریق این فیلد مقداردهی کنید.</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="QuoteItemCount">
            <label asp-for="QuoteItemCount">
                تعداد قلم کالا
                <span class="text-danger">*</span>
            </label>
            <input type="text" asp-for="QuoteItemCount" class="form-control" />
            <span class="hint">
                تعداد قلم کالا را از طریق این فیلد تعیین کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="QuoteItemFormat">
            <label asp-for="QuoteItemFormat">فرمت پارامتر قلم کالا<span class="text-danger">*</span></label>
            <input type="text" asp-for="QuoteItemFormat" class="form-control" />
            <span class="hint">
                مثال : WooCommerce.Order.{0}.Product
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="DiscountTitle">
            <label asp-for="DiscountTitle">شرح تخفیف</label>
            <input type="text" asp-for="DiscountTitle" class="form-control" />
            <span class="hint">شرح تخفیف را از طریق این فیلد مقداردهی کنید.</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="IsVerified">
            <label asp-for="IsVerified">
                تایید شده است؟
            </label>
            <input type="text" asp-for="IsVerified" class="form-control" />
            <span class="hint">
                قالب فرمت: "بله"، "خیر"، "1"، "0"، "False"، "True"
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Status">
            <label asp-for="Status">وضعیت</label>
            <input type="text" asp-for="Status" class="form-control" />
            <span class="hint">
                مقدار این فیلد میتواند به صورت «شناسه» یا «عنوان» وارد شود.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Group">
            <label asp-for="Group">گروه</label>
            <input type="text" asp-for="Group" class="form-control" />
            <span class="hint">
                مقدار این فیلد میتواند به صورت «شناسه» یا «عنوان» وارد شود.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Fixed">
            <label asp-for="Fixed">عدم ویرایش؟</label>
            <input type="text" asp-for="Fixed" class="form-control" />
            <span class="hint">
                قالب فرمت: "بله"، "خیر"، "1"، "0"، "False"، "True"
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="PayCondition">
            <label asp-for="PayCondition">شرایط پرداخت</label>
            <input type="text" asp-for="PayCondition" class="form-control" />
            <span class="hint">
                مقدار این فیلد میتواند به صورت «شناسه» یا «عنوان» وارد شود.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Description">
            <label asp-for="Description">توضیحات</label>
            <input type="text" asp-for="Description" class="form-control" />
            <span class="hint">
                توضیحات را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Description2">
            <label asp-for="Description2">توضیحات تکمیلی</label>
            <input type="text" asp-for="Description2" class="form-control" />
            <span class="hint">
                توضیحات تکمیلی را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="PrintFormat">
            <label asp-for="PrintFormat">
                فرمت چاپ
            </label>
            <input type="text" asp-for="PrintFormat" class="form-control" />
            <span class="hint">
                مقدار این فیلد میتواند به صورت «شناسه» یا «عنوان» وارد شود.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="AccountNumber">
            <label asp-for="AccountNumber">شماره حساب 1</label>
            <input type="text" asp-for="AccountNumber" class="form-control" />
            <span class="hint">
                شماره حساب 1 را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="ShabaNumber">
            <label asp-for="ShabaNumber">شماره شبا 2</label>
            <input type="text" asp-for="ShabaNumber" class="form-control" />
            <span class="hint">
                شماره شبا 1 را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Address">
            <label asp-for="Address">آدرس</label>
            <input type="text" asp-for="Address" class="form-control" />
            <span class="hint">
                آدرس را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Telephone">
            <label asp-for="Telephone">تلفن</label>
            <input type="text" asp-for="Telephone" class="form-control" />
            <span class="hint">
                 تلفن را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Website">
            <label asp-for="Website">وبسایت</label>
            <input type="text" asp-for="Website" class="form-control" />
            <span class="hint">
                وبسایت را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="Email">
            <label asp-for="Email">ایمیل</label>
            <input type="text" asp-for="Email" class="form-control" />
            <span class="hint">
                 ایمیل را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="TransportationCost">
            <label asp-for="TransportationCost">هزینه ایاب و ذهاب و حمل و نقل</label>
            <input type="text" asp-for="TransportationCost" class="form-control" />
            <span class="hint">
                هزینه حمل و نقل را از طریق این فیلد مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="ReferUser">
            <label asp-for="ReferUser">بازاریاب</label>
            <input type="text" asp-for="ReferUser" class="form-control" />
            <span class="hint">مقدار این فیلد میتواند به صورت «شناسه کاربری» یا «نام کاربری» وارد شود.</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="CreatorUser">
            <label asp-for="CreatorUser">کاربر ایجاد کننده</label>
            <input type="text" asp-for="CreatorUser" class="form-control" placeholder="@_options.Value.DefaultCreatorUser"/>
            <span class="hint">مقدار این فیلد میتواند به صورت «شناسه کاربری» یا «نام کاربری» وارد شود.</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="TotalDiscount">
            <label>تخفیف کل</label>
            <input type="text" asp-for="TotalDiscount" class="form-control" />
            <span class="hint">
              اگر سفارشی که قصد دارید به صورت پیش فاکتور در CRM ایده آل ثبت شود دارای تخفیف کل است، از طریق این فیلد تخفیف کل را مقداردهی کنید.
            </span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group" asp-validation-class-for="OutputQuote">
            <label asp-for="OutputQuote">
                شناسه متغیرهای خروجی پیش فاکتور
            </label>
            <input type="text" asp-for="OutputQuote" class="form-control" placeholder="Output.Ideal.Quote"/>
            <span class="hint">
                پیشوند متغیرهای خروجی پیش فاکتور از طریق این فیلد مقداردهی میشوند.
            </span>
        </div>
    </div>
</div>