    <div class="form-group" asp-validation-class-for="UserName">
      <label asp-for="UserName">نام کاربری</label>
      <input type="text" asp-for="UserName" class="form-control" placeholder="@_options.Value.UserName" />
      <span class="hint">برای دریافت کلید کاربری، تیکت جدیدی در باشگاه مشتریان CRM ایده آل ایجاد کنید.</span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Password">
      <label asp-for="Password">گذرواژه</label>
      <input type="text" asp-for="Password" class="form-control" placeholder="@_options.Value.Password" />
      <span class="hint">برای دریافت گذرواژه، تیکت جدیدی در باشگاه مشتریان CRM ایده آل ایجاد کنید.</span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="SearchKind">
      <label asp-for="SearchKind">نوع جستجو</label>
      <select asp-for="SearchKind" class="form-control">
        <option value="Id">شناسه(Id) پرسنل</option>
        <option value="Mobile">موبایل</option>
        <option value="Email">ایمیل</option>
        <option value="NationalCode">کد ملی</option>
      </select>
      <span class="hint">از لیست کشویی نوع پارامتر جستجو را تعیین کنید.</span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Filter">
      <label asp-for="Filter">عبارت جستجو <span class="text-danger">*</span></label>
      <input type="text" asp-for="Filter" class="form-control" />
      <span class="hint">متناسب با فیلتر «نوع جستجو» این فیلد مقداردهی شود.</span>
    </div>
  </div>
</div>
